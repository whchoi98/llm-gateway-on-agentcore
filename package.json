{
  "name": "agentcore-llm-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "LLM Gateway on Amazon Bedrock AgentCore Gateway (ap-northeast-2): Bedrock Global CRIS primary, Anthropic API fallback",
  "bin": { "agentcore-llm-gateway": "bin/app.js" },
  "scripts": {
    "build": "tsc --noEmit",
    "synth": "cdk synth",
    "diff": "cdk diff --all",
    "deploy": "cdk deploy --all --require-approval never",
    "destroy": "cdk destroy --all"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "aws-cdk": "2.1147.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0"
  },
  "dependencies": {
    "aws-cdk-lib": "2.275.0",
    "constructs": "^10.4.0"
  }
}
