# AWS credentials profile for the CDK CLI, the AWS CLI, and scripts/ (empty: default credential chain)
AWS_PROFILE=

# Inference endpoint the scripts call (empty: InferenceEndpoint from cdk-outputs.json)
LLM_GATEWAY_ENDPOINT=

# Claude Platform on AWS API key read by scripts/set-cponaws-key.sh (empty: the script prompts for it)
ANTHROPIC_API_KEY=

# Seoul workspace ID for scripts/set-cponaws-key.sh (empty: the SSM parameter /llm-gateway/anthropic-workspace-id, else a prompt)
ANTHROPIC_WORKSPACE_ID=

# Epoch seconds from which `smoke_test.py --only routing-evidence` reads routing logs (empty: start of the run)
EVIDENCE_SINCE=
